# Copy to .env and fill in. See docs/GOOGLE-APIS.md for the full inventory of
# Google APIs, which env var powers each, and how to enable them.

# ----------------------------- Database (Neon/Postgres) ----------------------
# Connection strings from a Neon Postgres project.
#   DATABASE_URL  = the *pooled* string (host contains "-pooler") — used by the
#                   serverless app runtime.
#   DIRECT_URL    = the *direct* (non-pooled) string — used by Prisma for
#                   migrations and transactions.
# In Vercel set both in Project → Settings → Environment Variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.PROVIDER.neon.tech/DBNAME?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@EP_HOST.REGION.PROVIDER.neon.tech/DBNAME?sslmode=require

# ------------------------------ Image uploads (Vercel Blob) ------------------
# Vercel injects BLOB_READ_WRITE_TOKEN automatically for Blob-connected
# projects — no need to set it manually in most cases.

# --------------------------------- Google APIs ---------------------------------
# Powers lead search (Places API (New), with legacy Places API as fallback),
# "Pull photos from Google", and real-review pulls in the site editor.
# NOTE: this key now needs "Places API (New)" enabled in Google Cloud too —
# same key, separate API. Until enabled, live search returns 403 and falls
# back to the legacy API. See docs/GOOGLE-APIS.md.
GOOGLE_PLACES_API_KEY=your-key-here

# On-demand Instagram handle lookup (Custom Search API).
# Falls back to GOOGLE_PLACES_API_KEY if unset.
GOOGLE_CUSTOM_SEARCH_API_KEY=your-key-here
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=your-cx-id-here

# "Fill blank service images" button in the site editor (free, instant).
PEXELS_API_KEY=your-key-here

# AI-driven bespoke design selection instead of the deterministic fallback.
ANTHROPIC_API_KEY=your-key-here

# Canonical origin for SEO/robots (defaults to http://localhost:3000).
# On Vercel set this to the deployment's origin, e.g. https://<project>.vercel.app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protects the /api/cron/daily-leads endpoint. Generate a random string
# (e.g. `openssl rand -hex 32`) and set the SAME value in Vercel → Settings →
# Environment Variables. Vercel Cron automatically sends it as
# `Authorization: Bearer <CRON_SECRET>` on the scheduled request.
CRON_SECRET=