generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum WebsiteStatus {
  NONE
  POOR
  HAS_SITE
}

enum LeadSource {
  GOOGLE_PLACES
  MOCK
}

enum OutreachStatus {
  NEW
  CONTACTED
  RESPONDED
  WON
  LOST
}

model Lead {
  id            String        @id @default(cuid())
  name          String
  category      String
  address       String
  phone         String?
  email         String?
  existingUrl   String?
  instagramHandle String?
  rating        Float?
  reviewCount   Int?
  city          String
  websiteStatus WebsiteStatus @default(NONE)
  source        LeadSource    @default(MOCK)
  placeId       String?       @unique
  createdAt     DateTime      @default(now())
  sites         Site[]

  outreachStatus  OutreachStatus @default(NEW)
  lastContactedAt DateTime?
  followUpAt      DateTime?
  outreachNotes   String?
  followUpCount   Int            @default(0)
  events          Event[]
}

enum SiteStatus {
  DRAFT
  PUBLISHED
}

model Site {
  id          String     @id @default(cuid())
  slug        String     @unique
  businessName String
  tagline     String?
  about       String?
  story       String?
  services    String?
  hours       String?
  phone       String?
  email       String?
  address     String?
  instagramHandle String?
  facebookUrl String?
  bookingUrl  String?
  guaranteeText String?
  paymentMethods String?
  photoUrl    String?
  storyPhotoUrl String?
  photoAttribution String?
  rating      Float?
  reviewCount Int?
  template    String     @default("classic")
  primaryColor String    @default("#2563eb")
  category    String?
  googlePlaceId String?
  googleReviewsJson String?
  googleReviewsUpdatedAt DateTime?
  googleMapsUrl String?
  designSystemId String?
  designRationale String?
  colorVariant Int?
  status      SiteStatus @default(DRAFT)
  utmTrackingEnabled Boolean @default(false)
  googleSiteVerification String?
  leadId      String?
  lead        Lead?      @relation(fields: [leadId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  events      Event[]
  serviceItems Service[]
  faqItems    FaqItem[]
  blogPosts   BlogPost[]
  galleryItems GalleryItem[]
  contactSubmissions ContactSubmission[]
  inspirationImages InspirationImage[]
}

model Service {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String?
  price       String?
  imageUrl    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([siteId, slug])
}

model FaqItem {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model BlogPost {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  slug      String
  title     String
  content   String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, slug])
}

model GalleryItem {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  beforeUrl String
  afterUrl  String
  caption   String?
  category  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model InspirationImage {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model ContactSubmission {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum EventType {
  LEAD_FOUND
  SITE_CREATED
  SITE_PUBLISHED
  SITE_VIEW
  LEAD_CONTACTED
  LEAD_RESPONDED
  LEAD_WON
  LEAD_LOST
  CONTACT_SUBMITTED
}

model Event {
  id        String    @id @default(cuid())
  type      EventType
  path      String?
  siteId    String?
  site      Site?     @relation(fields: [siteId], references: [id])
  leadId    String?
  lead      Lead?     @relation(fields: [leadId], references: [id])
  createdAt DateTime  @default(now())
}
