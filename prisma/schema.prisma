generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum WebsiteStatus {
  NONE
  POOR
  HAS_SITE
}

enum LeadSource {
  GOOGLE_PLACES
  MOCK
}

enum OutreachStatus {
  NEW
  CONTACTED
  RESPONDED
  WON
  LOST
}

model Lead {
  id            String        @id @default(cuid())
  name          String
  category      String
  address       String
  phone         String?
  email         String?
  existingUrl   String?
  instagramHandle String?
  rating        Float?
  reviewCount   Int?
  city          String
  websiteStatus WebsiteStatus @default(NONE)
  source        LeadSource    @default(MOCK)
  placeId       String?       @unique
  createdAt     DateTime      @default(now())
  sites         Site[]

  outreachStatus  OutreachStatus @default(NEW)
  lastContactedAt DateTime?
  followUpAt      DateTime?
  outreachNotes   String?
  followUpCount   Int            @default(0)
  events          Event[]
}

enum SiteStatus {
  DRAFT
  PUBLISHED
}

model Site {
  id          String     @id @default(cuid())
  slug        String     @unique
  businessName String
  tagline     String?
  about       String?
  story       String?
  services    String?
  hours       String?
  phone       String?
  email       String?
  address     String?
  instagramHandle String?
  facebookUrl String?
  bookingUrl  String?
  guaranteeText String?
  paymentMethods String?
  photoUrl    String?
  storyPhotoUrl String?
  photoAttribution String?
  rating      Float?
  reviewCount Int?
  template    String     @default("classic")
  primaryColor String    @default("#2563eb")
  category    String?
  googlePlaceId String?
  googleReviewsJson String?
  googleReviewsUpdatedAt DateTime?
  googleMapsUrl String?
  designSystemId String?
  designRationale String?
  colorVariant Int?
  status      SiteStatus @default(DRAFT)
  utmTrackingEnabled Boolean @default(false)
  googleSiteVerification String?
  customDomain String?
  deliveredAt DateTime?
  leadId      String?
  lead        Lead?      @relation(fields: [leadId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  events      Event[]
  serviceItems Service[]
  faqItems    FaqItem[]
  blogPosts   BlogPost[]
  galleryItems GalleryItem[]
  contactSubmissions ContactSubmission[]
  inspirationImages InspirationImage[]
  handoffTasks HandoffTask[]
}

model Service {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String?
  price       String?
  imageUrl    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([siteId, slug])
}

model FaqItem {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model BlogPost {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  slug      String
  title     String
  content   String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, slug])
}

model GalleryItem {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  beforeUrl String
  afterUrl  String
  caption   String?
  category  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model InspirationImage {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model ContactSubmission {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum EventType {
  LEAD_FOUND
  SITE_CREATED
  SITE_PUBLISHED
  SITE_VIEW
  LEAD_CONTACTED
  LEAD_RESPONDED
  LEAD_WON
  LEAD_LOST
  CONTACT_SUBMITTED
  SITE_DELIVERED
}

model HandoffTask {
  id        String    @id @default(cuid())
  siteId    String
  site      Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  key       String
  done      Boolean   @default(false)
  doneAt    DateTime?
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([siteId, key])
}

model Event {
  id        String    @id @default(cuid())
  type      EventType
  path      String?
  siteId    String?
  site      Site?     @relation(fields: [siteId], references: [id])
  leadId    String?
  lead      Lead?     @relation(fields: [leadId], references: [id])
  createdAt DateTime  @default(now())
}

model CronState {
  id           String    @id
  cursor       Int       @default(0)
  lastRunAt    DateTime?
  lastRunAdded Int?
  lastRunNote  String?
  updatedAt    DateTime  @updatedAt
}

// ── Frat House agent runtime (docs/FRAT-HOUSE-RUNTIME-PLAN.md) ──────────────

enum AgentStatus {
  IDLE
  RUNNING
  ERROR
  OFF
}

enum RunTrigger {
  CRON
  MANUAL
  CHAT
}

enum RunOutcome {
  OK
  ERROR
  SKIPPED_BUDGET
  SKIPPED_BUSY
}

enum TaskStatus {
  QUEUED
  DONE
  FAILED
}

enum ApprovalKind {
  DM_DRAFT
  FOLLOW_UP_DRAFT
  SITE_DRAFT
  NOTE
}

enum ApprovalState {
  PENDING
  APPROVED
  REJECTED
}

model Agent {
  id          String         @id // slug: "scout", "rush-chair", "pledge"
  name        String
  role        String
  model       String         @default("claude-haiku-4-5")
  enabled     Boolean        @default(true)
  status      AgentStatus    @default(IDLE)
  currentTask String?
  lastRunAt   DateTime?
  runs        AgentRun[]
  tasks       AgentTask[]
  approvals   Approval[]
  messages    AgentMessage[]
}

model AgentRun {
  id           String      @id @default(cuid())
  agentId      String
  agent        Agent       @relation(fields: [agentId], references: [id])
  trigger      RunTrigger
  outcome      RunOutcome? // null while running
  startedAt    DateTime    @default(now())
  finishedAt   DateTime?
  inputTokens  Int         @default(0)
  outputTokens Int         @default(0)
  costMicros   Int         @default(0) // 1_000_000 = $1.00
  summary      String?
  error        String?
  approvals    Approval[]

  @@index([startedAt])
}

model AgentTask {
  id        String     @id @default(cuid())
  agentId   String
  agent     Agent      @relation(fields: [agentId], references: [id])
  kind      String
  leadId    String?
  status    TaskStatus @default(QUEUED)
  createdAt DateTime   @default(now())
  doneAt    DateTime?

  @@index([agentId, status])
}

model Approval {
  id        String        @id @default(cuid())
  agentId   String
  agent     Agent         @relation(fields: [agentId], references: [id])
  runId     String?
  run       AgentRun?     @relation(fields: [runId], references: [id])
  kind      ApprovalKind
  leadId    String?
  siteId    String?
  title     String
  body      String
  state     ApprovalState @default(PENDING)
  createdAt DateTime      @default(now())
  decidedAt DateTime?

  @@index([state, createdAt])
}

model AgentMessage {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  @@index([agentId, createdAt])
}
